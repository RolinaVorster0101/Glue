<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>Glue</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Colors.axaml is a plain ResourceDictionary with no x:Class, so it isn't
         picked up by Avalonia's default glob under a plain Microsoft.NET.Sdk
         project and needs to be declared explicitly. It lives in the Styles/
         subfolder alongside Glue.csproj. -->
    <AvaloniaResource Include="Styles/Colors.axaml" />
    <!-- Custom C# syntax highlighting definition matching docs/STYLEGUIDE.md.
         Loaded manually in MainWindow.axaml.cs via HighlightingLoader, not
         picked up by any automatic mechanism, so it needs the same explicit
         treatment as Colors.axaml above. -->
    <AvaloniaResource Include="Styles/GlueCSharp.xshd" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.0" />
    <!-- DevTools (F12 at runtime): lets us inspect the live visual tree to find
         exact internal template part names/types, instead of guessing at
         Fluent theme internals blind. Debug-only — never ships in Release. -->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.0" Condition="'$(Configuration)' == 'Debug'" />
    <!-- Avalonia's port of AvalonEdit — the actual editor-core dependency for our shell.
         Note the package ID is "Avalonia.AvaloniaEdit", not just "AvaloniaEdit". -->
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.2.0" />
    <!-- Roslyn — hosted in-process for C# diagnostics/completion/formatting/folding -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" />
    <!-- CompletionService lives here, not in the packages above — needed for
         basic completion (Phase 1 item 3). -->
    <PackageReference Include="Microsoft.CodeAnalysis.Features" Version="4.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="4.11.0" />
  </ItemGroup>

</Project>
