<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:local="clr-namespace:Glue"
        xmlns:models="clr-namespace:Glue.Models"
        x:Class="Glue.MainWindow"
        Title="Glue"
        Width="1100" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgCanvasBrush}"
        KeyDown="OnWindowKeyDown">

    <DockPanel>

        <!-- Menu bar: File > Open / Save. This is the seed of the eventual
             Solution Explorer / project-aware shell from the roadmap. -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource BgSurfaceBrush}">
            <MenuItem Header="_File" Foreground="{DynamicResource TextPrimaryBrush}">
                <MenuItem Header="_New File" InputGesture="Ctrl+N" Click="OnNewFileClicked" />
                <MenuItem Header="Open _Folder..." Click="OnOpenFolderClicked" />
                <MenuItem Header="Open _Project (.csproj)..." Click="OnOpenProjectClicked" />
                <MenuItem Header="_Open File..." Click="OnOpenClicked" />
                <Separator />
                <MenuItem Header="_Save" InputGesture="Ctrl+S" Click="OnSaveClicked" />
                <MenuItem Header="Save _As..." InputGesture="Ctrl+Shift+S" Click="OnSaveAsClicked" />
                <!-- Save All is currently identical to Save — Glue only edits one
                     file at a time until multi-tab editing exists. Kept as its own
                     menu item now so the menu shape already matches what multi-file
                     editing will need later. -->
                <MenuItem Header="Save A_ll" Click="OnSaveAllClicked" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExitClicked" />
            </MenuItem>
            <MenuItem Header="_Edit" Foreground="{DynamicResource TextPrimaryBrush}">
                <MenuItem Header="_Undo" InputGesture="Ctrl+Z" Click="OnUndoClicked" />
                <MenuItem Header="_Redo" InputGesture="Ctrl+Y" Click="OnRedoClicked" />
                <Separator />
                <!-- Real find, via AvaloniaEdit's built-in SearchPanel (highlighting,
                     next/prev, Ctrl+F). Its stock UI is find-only — no built-in
                     replace box. Treating "Replace" as a near-term follow-up rather
                     than block this batch on it. -->
                <MenuItem Header="_Find..." InputGesture="Ctrl+F" Click="OnFindClicked" />
                <Separator />
                <MenuItem Header="Move Line _Up" InputGesture="Alt+Up" Click="OnMoveLineUpClicked" />
                <MenuItem Header="Move Line _Down" InputGesture="Alt+Down" Click="OnMoveLineDownClicked" />
                <MenuItem Header="_Duplicate Line" InputGesture="Ctrl+D" Click="OnDuplicateLineClicked" />
                <MenuItem Header="Toggle Line _Comment (Ctrl+/)" Click="OnToggleCommentClicked" />
                <Separator />
                <!-- Requires a project loaded via File > Open Project — real
                     cross-file navigation needs actual multiple documents,
                     which single-file analysis doesn't have. -->
                <MenuItem Header="_Go to Definition (Ctrl+Alt+G)" Click="OnGoToDefinitionClicked" />
                <MenuItem Header="_Find All References (Ctrl+Alt+R)" Click="OnFindAllReferencesClicked" />
                <Separator />
                <MenuItem Header="_Trigger Suggestion (Ctrl+Space)" Click="OnTriggerCompletionClicked" />
                <Separator />
                <!-- Ctrl+Alt+F is a placeholder single-key shortcut. A real VS-style
                     chord (Ctrl+K, Ctrl+D) needs proper keybinding infrastructure,
                     which arrives with the Command Palette / Settings work later
                     in docs/ROADMAP.md, section 2.15. -->
                <MenuItem Header="_Format Document" InputGesture="Ctrl+Alt+F" Click="OnFormatDocumentClicked" />
            </MenuItem>
            <MenuItem Header="_View" Foreground="{DynamicResource TextPrimaryBrush}">
                <MenuItem Header="Toggle _Sidebar" InputGesture="Ctrl+B" Click="OnToggleSidebarClicked" />
                <MenuItem Header="Toggle _Panel" InputGesture="Ctrl+J" Click="OnTogglePanelClicked" />
                <Separator />
                <MenuItem Header="_Expand All" Click="OnExpandAllClicked" />
                <MenuItem Header="_Collapse All" Click="OnCollapseAllClicked" />
            </MenuItem>
            <MenuItem Header="_Build" Foreground="{DynamicResource TextPrimaryBrush}">
                <!-- Runs the REAL `dotnet build` toolchain as a subprocess — not
                     Roslyn's in-process compile used for live diagnostics. This
                     surfaces things live diagnostics can't: NuGet restore
                     failures, MSBuild target errors, etc. Requires a project to
                     have been loaded via File > Open Project first. -->
                <MenuItem Header="_Build Project (Ctrl+Shift+B)" Click="OnBuildProjectClicked" />
                <Separator />
                <!-- `dotnet run` — rebuilds if needed, then launches the app,
                     streaming its console output live. No debugger attached yet
                     (that's DAP integration in Phase 4) — this is plain
                     run-without-debugging. -->
                <MenuItem Header="_Run Project (Ctrl+F5)" Click="OnRunProjectClicked" />
                <MenuItem Header="_Stop" Click="OnStopRunClicked" />
            </MenuItem>
        </Menu>

        <!-- Status bar: per the style guide, this is the one place a solid
             accent-color fill spans the full width — the "always visible"
             anchor of the shell, not just another gray strip. -->
        <Border DockPanel.Dock="Bottom" Padding="8,4" Background="{DynamicResource AccentBrush}">
            <TextBlock x:Name="StatusText" Text="No file open" Foreground="White" FontSize="12" />
        </Border>

        <!-- Bottom panel: Problems (live Roslyn diagnostics) and Output (real
             `dotnet build` subprocess output). More tabs (Terminal, Debug
             Console, Test Results) arrive with later roadmap items — this is
             the same tabbed-panel shape from the reference mockup, built out
             incrementally as each feature lands. -->
        <Border DockPanel.Dock="Bottom"
                x:Name="ProblemsBorder"
                Height="160"
                Background="{DynamicResource BgSurfaceBrush}"
                BorderBrush="{DynamicResource BgSurfaceRaisedBrush}"
                BorderThickness="0,1,0,0">
            <TabControl x:Name="BottomPanelTabs" Background="Transparent">
                <TabItem Header="Problems">
                    <DockPanel>
                        <TextBlock x:Name="ProblemsHeader"
                                   DockPanel.Dock="Top"
                                   Text="Problems"
                                   Margin="8,6,8,4"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ListBox x:Name="ProblemsList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 DoubleTapped="OnProblemDoubleTapped">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="local:DiagnosticDisplayItem">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,2">
                                        <TextBlock Text="{Binding SeverityGlyph}"
                                                   Foreground="{Binding SeverityBrush}"
                                                   FontWeight="Bold" Width="14" />
                                        <TextBlock Text="{Binding Message}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding LineLabel}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Output">
                    <ScrollViewer x:Name="OutputScrollViewer">
                        <TextBlock x:Name="OutputText"
                                   Text=""
                                   FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                                   FontSize="12"
                                   Margin="8"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="NoWrap" />
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="References">
                    <ListBox x:Name="ReferencesList"
                             Background="Transparent"
                             BorderThickness="0"
                             DoubleTapped="OnReferenceDoubleTapped">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:ReferenceDisplayItem">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,2">
                                    <TextBlock Text="{Binding FileName}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding LineLabel}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="11" />
                                    <TextBlock Text="{Binding LineText}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Explorer sidebar: opens a folder and lists its files, per
             docs/ROADMAP.md Phase 1 item 2 ("Solution/project parsing —
             open folder, list files, open .csproj"). Clicking a file loads
             it into the editor via the same LoadFileIntoEditor path used by
             File > Open File. -->
        <Border DockPanel.Dock="Left"
                x:Name="SidebarBorder"
                Width="220"
                Background="{DynamicResource BgSurfaceBrush}"
                BorderBrush="{DynamicResource BgSurfaceRaisedBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="EXPLORER"
                           Margin="8,6,8,4"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TreeView x:Name="ExplorerTree"
                          Background="Transparent"
                          SelectionChanged="OnExplorerSelectionChanged">
                    <!-- Found via Avalonia DevTools (F12): the actual expander
                         element is PART_ExpandCollapseChevron, a ToggleButton.
                         Targeting it precisely this time, rather than guessing. -->
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
                            <Setter Property="Width" Value="11" />
                            <Setter Property="Height" Value="11" />
                            <!-- Numerically centered already (confirmed via DevTools),
                                 but the triangle glyph itself sits slightly high within
                                 its own bounding box — this small top nudge compensates
                                 for that visually, by eye rather than by measurement. -->
                            <Setter Property="Margin" Value="0,3,0,0" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="RenderTransform" Value="scale(0.8)" />
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                        </Style>
                        <!-- Chevron SHAPE (making it a narrower arrow instead of a wide
                             rectangle) was attempted several ways — targeted XAML style
                             on Path#ChevronPath, pseudo-class-scoped variants, and a
                             code-behind approach — none reliably worked for both the
                             collapsed and expanded states at once. Parked for a later
                             UI-polish pass (docs/ROADMAP.md, Phase 6) rather than keep
                             sinking time into a purely cosmetic detail. Current state:
                             correctly sized (11x11) and centered, just not narrowed. -->
                        <!-- PART_ExpandCollapseChevronContainer's 12,0,12,0 margin is
                             set directly in Avalonia's built-in template markup, which
                             sits at a higher style priority than anything we can set
                             here via a Style selector — confirmed via DevTools (Bounds
                             stayed at the template's X=12 regardless of what we set
                             here). That margin gets fixed from code-behind instead;
                             see AdjustChevronContainerMargins() in MainWindow.axaml.cs. -->
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate x:DataType="models:FileTreeNode" ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="12" />
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
        </Border>

        <!-- The editor core itself: AvaloniaEdit's TextEditor.
             SyntaxHighlighting is set in code-behind. -->
        <ae:TextEditor x:Name="Editor"
                       FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                       FontSize="14"
                       ShowLineNumbers="True"
                       Background="{DynamicResource BgCanvasBrush}"
                       Foreground="{DynamicResource TextPrimaryBrush}" />

    </DockPanel>

</Window>
