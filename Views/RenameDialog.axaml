<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Glue.Views.RenameDialog"
        Title="Rename"
        Width="360" Height="150"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource BgSurfaceBrush}">

    <StackPanel Margin="16" Spacing="12">
        <TextBlock Text="New name:" Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBox x:Name="NameBox" KeyDown="OnNameBoxKeyDown" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Click="OnCancelClicked" />
            <Button Content="Rename" Click="OnRenameClicked" />
        </StackPanel>
    </StackPanel>

</Window>
